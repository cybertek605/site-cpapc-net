---
import Base from '../layouts/Base.astro';
import { site, telHref } from '../site.config';
---
<Base title={`Contact ${site.name}`} description={`Contact ${site.name} (${site.legalName}), ${site.location}.`}>
  <main>
    <h1>Contact {site.name}</h1>
    <p class="sub">{site.legalName}, {site.location}</p>

    <dl class="ledger">
      <div class="entry"><dt>Phone</dt><dd><a href={telHref}>{site.phone}</a></dd></div>
      <div class="entry"><dt>Office</dt><dd>{site.address}</dd></div>
    </dl>

    <h2>Send us a message</h2>
    <form id="contact-form" data-endpoint={site.formEndpoint} data-phone={site.phone} novalidate>
      <p class="field"><label for="name">Name <span class="req">(required)</span></label><input id="name" name="name" type="text" autocomplete="name" maxlength="100" required /></p>
      <p class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" maxlength="200" /></p>
      <p class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="30" /></p>
      <p class="field"><label for="message">Message <span class="req">(required)</span></label><textarea id="message" name="message" rows="5" maxlength="3000" required></textarea></p>

      <p class="consent">
        <label>
          <input type="checkbox" name="sms_consent" value="yes" />
          <span>I consent to receive text messages ({site.sms.messageTypes}) from {site.name} at the phone number I provided. I acknowledge that my consent is not a condition of receiving services. Msg &amp; data rates may apply. Msg frequency varies. Reply HELP for assistance or STOP to opt out of receiving messages. Privacy Policy and Terms: <a href="/privacy-policy">{site.domain}/privacy-policy</a>.</span>
        </label>
      </p>

      <!-- spam traps: hidden field + form-open timestamp -->
      <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="website_url_hp" tabindex="-1" autocomplete="off" /></label></div>
      <input type="hidden" name="ts" id="ts" value="" />

      <p><button class="btn" type="submit">Send message</button></p>
      <p id="form-status" role="status" aria-live="polite"></p>
      <noscript><p>This form needs JavaScript. Please call us at {site.phone}.</p></noscript>
    </form>
  </main>
</Base>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    var statusEl = document.getElementById('form-status');
    document.getElementById('ts').value = String(Date.now());
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = form.elements['name'].value.trim();
      var email = form.elements['email'].value.trim();
      var phone = form.elements['phone'].value.trim();
      var message = form.elements['message'].value.trim();
      var consent = form.elements['sms_consent'].checked;
      if (!name || !message) { statusEl.textContent = 'Please enter your name and a message.'; return; }
      if (!email && !phone) { statusEl.textContent = 'Please enter an email address or a phone number.'; return; }
      if (consent && !phone) { statusEl.textContent = 'Please enter your phone number so we can text you, or uncheck the text message box.'; return; }
      var data = new URLSearchParams();
      new FormData(form).forEach(function (v, k) { data.append(k, String(v)); });
      var btn = form.querySelector('button[type=submit]');
      btn.disabled = true; statusEl.textContent = 'Sending...';
      fetch(form.getAttribute('data-endpoint'), { method: 'POST', body: data })
        .then(function (res) {
          if (res.ok) { form.reset(); document.getElementById('ts').value = String(Date.now()); statusEl.textContent = 'Thank you. Your message was sent.'; }
          else if (res.status === 400) { statusEl.textContent = 'Please check your name, message, and contact details and try again.'; }
          else { throw new Error('bad status'); }
        })
        .catch(function () { statusEl.textContent = 'Sorry, something went wrong. Please call us at ' + form.getAttribute('data-phone') + '.'; })
        .then(function () { btn.disabled = false; });
    });
  })();
</script>

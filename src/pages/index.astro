---
import Base from '../layouts/Base.astro';
import { site, telHref } from '../site.config';
import { home } from '../content';
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`;
---
<Base title={`${site.name} | ${site.legalName}`} description={`${site.name} (${site.legalName}), a CPA firm in ${site.location}.`}>
  <main>
    <section class="hero">
      <h1>{site.name}</h1>
      <p class="legal-name">{site.legalName}</p>
      <p class="tagline">{home.tagline}</p>
      <p class="intro">{home.intro}</p>
      <p class="actions">
        <a class="btn" href={telHref}>Call {site.phone}</a>
        <a class="btn btn-quiet" href="/contact">Send a message</a>
      </p>
      <dl class="ledger">
        <div class="entry"><dt>Phone</dt><dd><a href={telHref}>{site.phone}</a></dd></div>
        <div class="entry"><dt>Office</dt><dd>{site.address}</dd></div>
        <div class="entry"><dt>Hours</dt><dd>{home.hours}</dd></div>
        <div class="entry"><dt>Directions</dt><dd><a href={mapsHref}>Open in Google Maps</a></dd></div>
      </dl>
    </section>

    <section>
      <h2>What we do</h2>
      <ul class="rows">
        {home.services.map((s) => (
          <li><strong>{s.title}</strong>{s.text}</li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Text message updates</h2>
      <p class="note">You can choose to receive text messages from us. Texting is optional. To sign up, enter your phone number on our <a href="/contact">contact form</a> and select the text message checkbox. Reply STOP at any time to opt out. See our <a href="/privacy-policy">Privacy Policy</a> and <a href="/privacy-policy#terms">Text Messaging Terms</a>.</p>
    </section>
  </main>
</Base>

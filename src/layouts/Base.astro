---
// Deliberately bare: NO analytics, NO session replay, NO trackers, NO third-party requests.
// Fonts are self-hosted from the npm packages below (nothing loads from Google).
import '@fontsource/zilla-slab/latin-500.css';
import '@fontsource/zilla-slab/latin-600.css';
import '@fontsource/zilla-slab/latin-700.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import { site } from '../site.config';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1F3B33" />
    <style is:global>
      :root {
        --paper: #E9EFE3;   /* ledger paper */
        --sheet: #FBFCF8;   /* white sheet */
        --rule: #BFD0B8;    /* ruled row lines */
        --leader: #8FA886;  /* dotted leaders */
        --green: #1F3B33;   /* deep green ink: headings, buttons */
        --ink: #2E3D36;     /* body text */
        --muted: #51625A;   /* secondary text */
        --link: #14543F;
        --red: #B3262E;     /* red ledger ink: rules only */
        --slab: 'Zilla Slab', Georgia, 'Times New Roman', serif;
        --sans: 'Source Sans 3', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); font-size: 1.1875rem; line-height: 1.65; }
      h1, h2, h3 { font-family: var(--slab); color: var(--green); line-height: 1.15; margin: 0; }
      h1 { font-weight: 700; font-size: clamp(2.4rem, 8vw, 4.25rem); letter-spacing: -0.01em; }
      h2 { font-weight: 600; font-size: 1.75rem; margin: 3rem 0 1rem; padding-bottom: .4rem; border-bottom: 2px solid var(--green); }
      h3 { font-weight: 600; font-size: 1.25rem; margin: 1.75rem 0 .35rem; }
      p { margin: 0 0 1rem; }
      a { color: var(--link); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
      a:hover { text-decoration-thickness: 2px; }
      :focus-visible { outline: 3px solid var(--red); outline-offset: 3px; border-radius: 2px; }

      /* masthead: the red double rule is the ledger heading */
      .masthead { background: var(--sheet); border-bottom: 6px double var(--red); }
      .masthead .in { max-width: 46rem; margin: 0 auto; padding: 1rem 1.25rem; display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: .5rem 1.5rem; }
      .brand { font-family: var(--slab); font-weight: 700; font-size: 1.5rem; color: var(--green); text-decoration: none; }
      .masthead nav a { margin-left: 1.25rem; font-size: 1rem; }
      .masthead nav a:first-child { margin-left: 0; }

      main { max-width: 46rem; margin: 0 auto; padding: 2.5rem 1.25rem 4.5rem; }
      main > h1 { margin-bottom: .75rem; font-size: clamp(2rem, 6vw, 2.75rem); }
      .sub { color: var(--muted); margin: 0 0 2rem; }

      /* home hero */
      .hero { padding-bottom: .5rem; }
      .legal-name { color: var(--muted); font-size: 1.25rem; margin: .35rem 0 1.5rem; }
      .tagline { font-family: var(--slab); font-weight: 500; font-size: clamp(1.4rem, 4.5vw, 1.9rem); line-height: 1.25; color: var(--green); margin: 0 0 .5rem; }
      .intro { max-width: 34rem; margin: 0 0 1.75rem; }
      .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin: 0 0 2.25rem; }
      .btn { display: inline-block; font: 600 1.0625rem var(--sans); padding: .75rem 1.5rem; border-radius: 3px; background: var(--green); color: #fff; text-decoration: none; border: 2px solid var(--green); cursor: pointer; }
      .btn:hover { background: #17302A; border-color: #17302A; text-decoration: none; }
      .btn-quiet { background: transparent; color: var(--green); }
      .btn-quiet:hover { background: var(--sheet); color: var(--green); }
      .btn[disabled] { opacity: .6; cursor: default; }

      /* ledger entries: label ........ value */
      .ledger { margin: 0; padding: 0; background: var(--sheet); border: 1px solid var(--rule); border-top: 3px solid var(--green); }
      .entry { display: flex; align-items: baseline; gap: .75rem; padding: .7rem 1rem; border-bottom: 1px solid var(--rule); }
      .entry:last-child { border-bottom: 0; }
      .entry dt { flex: 1 1 auto; display: flex; align-items: baseline; gap: .6rem; font-weight: 600; color: var(--green); white-space: nowrap; }
      .entry dt::after { content: ''; flex: 1 1 1rem; min-width: 1rem; border-bottom: 2px dotted var(--leader); transform: translateY(-.25em); }
      .entry dd { margin: 0; text-align: right; flex: 0 1 auto; max-width: 70%; }

      /* services: ruled rows, not cards */
      .rows { list-style: none; margin: 0; padding: 0; }
      .rows li { padding: .9rem 0; border-bottom: 1px solid var(--rule); }
      .rows li:first-child { border-top: 1px solid var(--rule); }
      .rows strong { font-family: var(--slab); font-weight: 600; font-size: 1.3rem; color: var(--green); display: block; }

      .note { border-left: 4px solid var(--red); padding: .25rem 0 .25rem 1rem; max-width: 36rem; }

      /* contact form */
      form { margin-top: 1.5rem; max-width: 36rem; }
      .field { margin: 0 0 1.25rem; }
      label { font-weight: 600; color: var(--green); }
      .req { font-weight: 400; color: var(--muted); font-size: .95rem; }
      input[type="text"], input[type="email"], input[type="tel"], textarea { display: block; width: 100%; margin-top: .3rem; padding: .65rem .75rem; font: inherit; color: var(--ink); background: var(--sheet); border: 2px solid var(--green); border-radius: 3px; }
      textarea { min-height: 8rem; }
      .consent { background: var(--sheet); border: 1px solid var(--rule); border-left: 4px solid var(--red); padding: 1rem 1.1rem; font-size: 1rem; line-height: 1.55; margin: 0 0 1.25rem; }
      .consent label { font-weight: 400; color: var(--ink); display: flex; gap: .75rem; align-items: flex-start; }
      .consent input[type="checkbox"] { flex: none; width: 1.35rem; height: 1.35rem; margin-top: .2rem; accent-color: var(--green); }
      .hp { position: absolute; left: -9999px; height: 0; overflow: hidden; }
      #form-status { font-weight: 600; color: var(--green); min-height: 1.65rem; }

      /* privacy + terms: comfortable measure */
      .legal main, main.legal { max-width: 42rem; }
      main.legal h2 { font-size: 1.9rem; }
      main.legal h2:first-of-type { margin-top: 2rem; }

      footer { max-width: 46rem; margin: 0 auto; padding: 0 1.25rem 3rem; color: var(--muted); font-size: .95rem; }
      footer .in { border-top: 1px solid var(--leader); padding-top: 1.25rem; }
      footer p { margin: 0 0 .5rem; }
      footer .links a { margin-right: 1.25rem; }

      @media (max-width: 30rem) {
        body { font-size: 1.125rem; }
        .entry { flex-wrap: wrap; }
        .entry dd { max-width: 100%; text-align: left; flex-basis: 100%; }
        .entry dt::after { display: none; }
        .masthead nav a { margin-left: 0; margin-right: 1.1rem; }
        .actions .btn { flex: 1 1 100%; text-align: center; }
      }
    </style>
  </head>
  <body>
    <header class="masthead"><div class="in">
      <a class="brand" href="/">{site.name}</a>
      <nav aria-label="Main"><a href="/contact">Contact</a><a href="/privacy-policy#terms">Text Messaging Terms</a><a href="/privacy-policy">Privacy Policy</a></nav>
    </div></header>
    <slot />
    <footer><div class="in">
      <p class="links"><a href="/contact">Contact</a><a href="/privacy-policy">Privacy Policy</a><a href="/privacy-policy#terms">Text Messaging Terms</a></p>
      <p>&copy; {site.name}. {site.name} is {site.legalName}. {site.address}. {site.phone}</p>
    </div></footer>
  </body>
</html>
